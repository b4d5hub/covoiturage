{% extends 'base.html.twig' %}
{% import '_ui.html.twig' as ui %}

{% block title %}Connexion – Covoiturage régional{% endblock %}

{% block body %}
    <div class="container auth">
        <section class="card auth-card">
            <div class="auth-head">
                {{ ui.auth_logo() }}
                <h1>Connexion</h1>
                <p class="muted">{{ booking ? 'Connectez-vous pour reprendre votre réservation.' : 'Retrouvez vos réservations et vos trajets.' }}</p>
            </div>

            {% if error %}
                {{ ui.notice('error', 'Adresse e-mail ou mot de passe incorrect.') }}
            {% endif %}

            {% include 'security/_booking_handoff.html.twig' %}

            <form method="post" action="{{ path('app_login') }}">
                <div class="field">
                    <label for="username">Adresse e-mail</label>
                    <input type="email" id="username" name="_username" value="{{ last_username }}" autocomplete="email" required autofocus>
                </div>
                <div class="field">
                    <label for="password">Mot de passe</label>
                    <input type="password" id="password" name="_password" autocomplete="current-password" required>
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                {{ ui.button('Se connecter', {block: true, busy: 'Connexion…'}) }}
            </form>

            <p class="auth-foot">Pas encore de compte ? <a href="{{ path('app_register', booking ? booking.parameters : {}) }}">Créer un compte</a></p>
        </section>
    </div>
{% endblock %}
