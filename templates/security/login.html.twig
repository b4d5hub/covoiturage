{% extends 'base.html.twig' %}

{% block title %}Connexion – Covoiturage régional{% endblock %}

{% block body %}
    <section class="card narrow">
        <h1>Connexion</h1>

        {% if error %}
            <div class="flash flash-error">Adresse e-mail ou mot de passe incorrect.</div>
        {% endif %}

        <form method="post" action="{{ path('app_login') }}">
            <div>
                <label for="username">Adresse e-mail</label>
                <input type="email" id="username" name="_username" value="{{ last_username }}" autocomplete="email" required autofocus>
            </div>
            <div>
                <label for="password">Mot de passe</label>
                <input type="password" id="password" name="_password" autocomplete="current-password" required>
            </div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <button class="button" type="submit">Se connecter</button>
        </form>

        <p class="muted">Pas encore de compte ? <a href="{{ path('app_register') }}">Créer un compte</a></p>
    </section>
{% endblock %}
