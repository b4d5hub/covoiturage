{# Composants d'interface partagés. Import : {% import '_ui.html.twig' as ui %} #}

{% macro auth_logo() %}
    <img class="auth-logo" src="{{ asset('images/icone-covoiturage.png') }}" width="64" height="64" alt="">
{% endmacro %}

