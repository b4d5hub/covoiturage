{# Pastille d'état. tone : ok, warn, danger, info ou neutre. #}
{% macro status(label, tone = null) %}
    <span class="status{{ tone ? ' status-' ~ tone }}">{{ label }}</span>
{%- endmacro %}

{# Message d'information dans la page. type : success, error, info, warning, plain. #}
{% macro notice(type, message, title = null) %}
    {%- import _self as ui -%}
    {%- set icons = {success: 'checkCircle', error: 'alert', info: 'info', warning: 'alert', plain: 'info'} -%}
    <div class="flash flash-{{ type }}"{% if type == 'error' %} role="alert"{% endif %}>
        {{ ui.icon(icons[type] ?? 'info') }}
        <div>
            {% if title %}<p class="flash-title">{{ title }}</p>{% endif %}
            <p>{{ message }}</p>
        </div>
    </div>
{%- endmacro %}

{# État vide : icône, titre, explication et action facultative. #}
{% macro empty(icon, title, text = null, url = null, label = null, compact = false) %}
    {%- import _self as ui -%}
    <div class="empty{{ compact ? ' empty-compact' }}">
        <span class="empty-icon">{{ ui.icon(icon, 'icon-lg') }}</span>
        <p class="empty-title">{{ title }}</p>
        {% if text %}<p>{{ text }}</p>{% endif %}
        {% if url %}<a class="button{{ compact ? ' button-secondary button-small' }}" href="{{ url }}">{{ label }}</a>{% endif %}
    </div>
{%- endmacro %}

{# Note moyenne : « ★ 4,5 · 2 avis » ou « Nouveau membre ». #}
{% macro rating(rating) %}
    {%- import _self as ui -%}
    {%- if rating.count > 0 -%}
        <span class="rating">{{ ui.icon('star') }}{{ rating.average|number_format(1, ',') }}<span class="muted">&nbsp;· {{ rating.count }}&nbsp;avis</span></span>
    {%- else -%}
        <span class="muted">Pas encore d'avis</span>
    {%- endif -%}
{%- endmacro %}

{# Cinq étoiles pour une note entière. #}
{% macro stars(value) %}
    {%- import _self as ui -%}
    <span class="stars" role="img" aria-label="{{ value }} sur 5">
        {%- for i in 1..5 -%}{{ ui.icon('star', i <= value ? 'is-on') }}{%- endfor -%}
    </span>
{%- endmacro %}

{# « 3 places », « 1 place ». #}
{% macro seats(count) %}{{ count }} place{{ count != 1 ? "s" }}{% endmacro %}

{% macro button(label, options = {}) %}
    {% set classes = 'button button-' ~ (options.variant|default('primary')) ~ (options.block|default(false) ? ' button-block') %}
    {% if options.href is defined %}
        <a class="{{ classes }}" href="{{ options.href }}">{% if options.icon is defined %}{{ _self.icon(options.icon) }}{% endif %}{{ label }}</a>
    {% else %}
        <button class="{{ classes }}" type="submit"{% if options.busy is defined %} data-busy-label="{{ options.busy }}"{% endif %}{% if options.booking|default(false) %} data-booking-submit{% endif %}>{% if options.icon is defined %}{{ _self.icon(options.icon) }}{% endif %}{{ label }}</button>
    {% endif %}
{% endmacro %}

{% macro availability(count, fullLabel = 'Complet entre ces étapes') %}
    {% if count > 0 %}
        {{ _self.status(_self.seats(count)|trim ~ (count == 1 ? ' libre' : ' libres'), count == 1 ? 'warn' : 'ok') }}
    {% else %}
        {{ _self.status(fullLabel, 'danger') }}
    {% endif %}
{% endmacro %}
