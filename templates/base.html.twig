<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Covoiturage régional{% endblock %}</title>
        <link rel="stylesheet" href="{{ asset('css/app.css') }}">
        {% block stylesheets %}{% endblock %}
    </head>
    <body>
        <header class="site-header">
            <div class="container header-inner">
                <a class="brand" href="{{ path('app_home') }}">Covoiturage régional</a>
                <nav class="main-nav" aria-label="Navigation principale">
                    <a href="{{ path('app_home') }}">Rechercher</a>
                    {% if app.user %}
                        <a href="{{ path('app_driver_publish') }}">Publier un trajet</a>
                        <a href="{{ path('app_my_bookings') }}">Mes réservations</a>
                        <a href="{{ path('app_driver') }}">Espace conducteur</a>
                        {% set unread = unread_notifications() %}
                        <a href="{{ path('app_notifications') }}">Notifications{% if unread > 0 %} <span class="badge">{{ unread }}</span>{% endif %}</a>
                        <a href="{{ path('app_my_profile') }}">Mon profil</a>
                        {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('admin') }}">Administration</a>{% endif %}
                        <a href="{{ path('app_logout') }}">Déconnexion</a>
                    {% else %}
                        <a href="{{ path('app_login') }}">Connexion</a>
                        <a class="button button-small" href="{{ path('app_register') }}">Inscription</a>
                    {% endif %}
                </nav>
            </div>
        </header>

        <main class="container">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash flash-{{ type }}" role="status">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        <footer class="site-footer">
            <div class="container">Paiement simulé : aucun paiement réel n'est effectué. Les personnes et trajets de démonstration sont fictifs.</div>
        </footer>
        {% block javascripts %}{% endblock %}
    </body>
</html>
