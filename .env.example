# Modèle de configuration, sans aucun secret.
# Le conteneur PHP copie ce fichier vers .env au premier démarrage.

###> symfony/framework-bundle ###
APP_ENV=dev
# Laissé vide : généré automatiquement dans .env au démarrage du conteneur.
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# URL de base utilisée pour générer des liens hors requête HTTP (commandes console).
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Valeur indicative : sous Docker Compose, cette variable est fournie par compose.yaml.
DATABASE_URL="mysql://covoiturage:change_me@db:3306/covoiturage?serverVersion=8.4&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

# Surcharges facultatives pour Docker Compose (décommenter avant le premier démarrage) :
# APP_PORT=8000
# DB_NAME=covoiturage
# DB_USER=covoiturage
# DB_PASSWORD=
