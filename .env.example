# Modèle de configuration, sans aucun secret.
# Le conteneur PHP copie ce fichier vers .env au premier démarrage.

###> symfony/framework-bundle ###
APP_ENV=dev
# Laissé vide : généré automatiquement dans .env au démarrage du conteneur.
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# URL de base utilisée pour générer des liens hors requête HTTP (commandes console).
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Valeur indicative : sous Docker Compose, cette variable est fournie par compose.yaml.
DATABASE_URL="mysql://covoiturage:change_me@db:3306/covoiturage?serverVersion=8.4&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###

# Services OpenStreetMap (niveau 4). Leurs adresses sont modifiables sans changer le code.
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSRM_URL=https://router.project-osrm.org
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Identification de l'application exigée par les politiques d'usage (pas d'agent générique).
OSM_USER_AGENT="CovoiturageRegional/1.0 (+https://github.com/b4d5hub/covoiturage)"
# Tarif du prix suggéré, en centimes de MAD par kilomètre (50 = 0,50 MAD/km).
PRICE_PER_KM_CENTS=50

# Mot de passe commun des comptes fictifs créés par les données de démonstration.
# Il ne protège aucune donnée réelle ; à ne jamais réutiliser ailleurs.
DEMO_PASSWORD=demo-covoiturage

# Surcharges facultatives pour Docker Compose (décommenter avant le premier démarrage) :
# APP_PORT=8000
# DB_NAME=covoiturage
# DB_USER=covoiturage
# DB_PASSWORD=
